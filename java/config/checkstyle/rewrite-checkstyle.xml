<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  This Checkstyle configuration is NOT used by the 'checkstyle' Gradle task. It exists solely to
  steer OpenRewrite's code style.

  OpenRewrite derives a style from the Checkstyle plugin's configuration. As of the openrewrite
  plugin 7.35.0, when no 'Indentation' module is present it falls back to its own default
  continuation indent of 8 spaces, which overrides our 4-space 'com.zeroc.IceRewriteStyle' and
  reformats the whole codebase. Pointing 'rewrite.checkstyleConfigFile' at this file makes the
  derived style use a 4-space continuation indent, matching our style and our 120-column limit.
-->
<module name="Checker">
  <module name="TreeWalker">
    <module name="Indentation">
      <property name="basicOffset" value="4"/>
      <property name="lineWrappingIndentation" value="4"/>
    </module>
  </module>
</module>
